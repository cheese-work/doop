{
  "groups": [
    {
      "group": "/.well-known",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/.well-known/oauth-authorization-server",
          "auth": false
        }
      ],
      "noWrite": "discovery documents are read-only by definition"
    },
    {
      "group": "/a",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/a/none.png",
          "expect": [404],
          "contract": "a missing file answers 404: the route and its store are up",
          "auth": false
        }
      ],
      "noWrite": "asset routes are read-only; there is nothing to write"
    },
    {
      "group": "/api",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/api/not-a-route",
          "expect": [404],
          "contract": "an unknown /api path answers 404 JSON, not the SPA page"
        }
      ],
      "noWrite": "the group has no route of its own; the real /api routes are the other groups"
    },
    {
      "group": "/api/account-exists",
      "calls": [
        {
          "kind": "read",
          "method": "POST",
          "path": "/api/account-exists",
          "expect": [200],
          "body": {
            "email": "{email}"
          },
          "expectJson": {
            "exists": "true"
          },
          "auth": false
        },
        {
          "kind": "read",
          "method": "POST",
          "path": "/api/account-exists",
          "expect": [200],
          "body": {
            "email": "nobody@compat.invalid"
          },
          "expectJson": {
            "exists": "false"
          },
          "auth": false
        }
      ],
      "noWrite": "a lookup: it changes no state"
    },
    {
      "group": "/api/admin",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/api/admin/stats",
          "expect": [404],
          "contract": "a non-admin gets 404 by design so the surface stays hidden"
        }
      ],
      "noWrite": "admin routes are read-only and hidden from a non-admin"
    },
    {
      "group": "/api/agent-allowance",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/agent-allowance"
        }
      ],
      "noWrite": "the allowance is derived from the plan; nothing to write"
    },
    {
      "group": "/api/agent-runners",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/agent-runners"
        }
      ],
      "noWrite": "the default runner can only be set to a connected, enabled account; the sandbox has none"
    },
    {
      "group": "/api/agent-keys",
      "calls": [
        {
          "kind": "write",
          "method": "POST",
          "path": "/api/agent-keys",
          "body": {
            "name": "deploy-smoke"
          },
          "save": {
            "keyId": "id",
            "agentKey": "secret"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/agent-keys",
          "expectJson": {
            "0.id": "{keyId}",
            "0.name": "deploy-smoke"
          }
        }
      ]
    },
    {
      "group": "/api/agents",
      "calls": [
        {
          "kind": "write",
          "method": "POST",
          "path": "/api/agents",
          "body": {
            "name": "Smoke Bot",
            "handle": "smokebot",
            "blurb": "Checks a deploy before it ships",
            "brief": "Reply to every request with one short line.",
            "color": "#0177D3"
          },
          "save": {
            "agentHandle": "id"
          },
          "expectJson": {
            "id": "smokebot",
            "name": "Smoke Bot"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/agents",
          "expectJson": {
            "0.id": "{agentHandle}",
            "0.name": "Smoke Bot",
            "0.blurb": "Checks a deploy before it ships"
          }
        },
        {
          "kind": "write",
          "method": "PATCH",
          "path": "/api/agents/{agentHandle}",
          "body": {
            "blurb": "Checks a deploy twice"
          },
          "expectJson": {
            "id": "{agentHandle}",
            "blurb": "Checks a deploy twice"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/agents",
          "expectJson": {
            "0.id": "{agentHandle}",
            "0.blurb": "Checks a deploy twice"
          }
        }
      ]
    },
    {
      "group": "/api/auth",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/auth/get-session",
          "auth": false
        },
        {
          "kind": "write",
          "method": "POST",
          "path": "/api/auth/sign-in/email",
          "body": {
            "email": "{email}",
            "password": "{password}"
          },
          "auth": false,
          "expectJson": {
            "user.email": "{email}"
          }
        },
        {
          "kind": "contract",
          "method": "POST",
          "path": "/api/auth/sign-in/email",
          "expect": [401],
          "contract": "a wrong password must be refused",
          "body": {
            "email": "{email}",
            "password": "not-the-password-1"
          },
          "auth": false
        }
      ]
    },
    {
      "group": "/api/automations",
      "calls": [
        {
          "kind": "write",
          "method": "POST",
          "path": "/api/automations",
          "body": {},
          "save": {
            "automationId": "id"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/automations/{automationId}",
          "expectJson": {
            "id": "{automationId}"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/automations"
        },
        {
          "kind": "write",
          "method": "DELETE",
          "path": "/api/automations/{automationId}"
        }
      ]
    },
    {
      "group": "/api/billing",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/billing/plans"
        }
      ],
      "noWrite": "plans are static; checkout needs Stripe, which the sandbox does not have"
    },
    {
      "group": "/api/canvases",
      "calls": [
        {
          "kind": "write",
          "method": "POST",
          "path": "/api/canvases",
          "body": {
            "name": "Deploy smoke"
          },
          "save": {
            "canvasId": "id",
            "pageId": "pages.0.id"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/canvases/{canvasId}",
          "expectJson": {
            "id": "{canvasId}",
            "name": "Deploy smoke"
          }
        },
        {
          "kind": "write",
          "method": "PATCH",
          "path": "/api/canvases/{canvasId}",
          "body": {
            "name": "Renamed"
          },
          "expectJson": {
            "ok": "true"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/canvases/{canvasId}",
          "expectJson": {
            "name": "Renamed"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/canvases"
        }
      ]
    },
    {
      "group": "/api/comments",
      "calls": [
        {
          "kind": "write",
          "method": "POST",
          "path": "/api/canvases/{canvasId}/comments",
          "body": {
            "pageId": "{pageId}",
            "x": 10,
            "y": 10,
            "text": "deploy smoke"
          },
          "save": {
            "commentId": "id"
          },
          "expectJson": {
            "text": "deploy smoke"
          }
        },
        {
          "kind": "write",
          "method": "POST",
          "path": "/api/comments/{commentId}/resolve",
          "body": {},
          "expectJson": {
            "id": "{commentId}"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/home/activity"
        }
      ]
    },
    {
      "group": "/api/community",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/community"
        }
      ],
      "noWrite": "copying needs a published canvas from another account"
    },
    {
      "group": "/api/custom-providers",
      "calls": [
        {
          "kind": "contract",
          "method": "POST",
          "path": "/api/custom-providers",
          "body": {},
          "expectByStatus": {
            "400": {
              "error": "Give the provider a name"
            },
            "404": {
              "error": "custom providers are off on this server"
            }
          },
          "contract": "an empty provider is refused with the validation text (400) when custom providers are on, or with the off text (404) when they are off; creating one stores a key and probing calls an outside host. An absent route answers neither body"
        }
      ],
      "noWrite": "creating a provider stores an endpoint and a key, and a probe calls an outside host; the contract call proves the route and its on/off switch"
    },
    {
      "group": "/api/design-attestations",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/api/design-attestations/none",
          "expectByStatus": {
            "404": {
              "error": "attestation not found"
            }
          },
          "contract": "an unknown attestation id answers the route's own 404 text, so the route and its table are up; an absent route answers a different body. A real attestation needs a design check run, which the sandbox does not have"
        }
      ],
      "noWrite": "attestations are read-only; the server's own check run writes them, there is no write route"
    },
    {
      "group": "/api/feedback",
      "calls": [
        {
          "kind": "contract",
          "method": "POST",
          "path": "/api/feedback/none/retry",
          "expect": [404],
          "contract": "an unknown feedback id is refused with 404",
          "body": {}
        }
      ],
      "noWrite": "feedback is created by an agent run; the sandbox has no agent"
    },
    {
      "group": "/api/fonts",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/fonts"
        }
      ],
      "noWrite": "an upload needs real font bytes and a stored file in the live volume"
    },
    {
      "group": "/api/frames",
      "calls": [
        {
          "kind": "write",
          "method": "POST",
          "path": "/api/canvases/{canvasId}/frames",
          "body": {
            "name": "Smoke frame",
            "html": "<div>smoke</div>"
          },
          "save": {
            "frameId": "id"
          },
          "expectJson": {
            "name": "Smoke frame"
          }
        },
        {
          "kind": "write",
          "method": "PATCH",
          "path": "/api/frames/{frameId}",
          "body": {
            "name": "Smoke frame 2"
          },
          "expectJson": {
            "name": "Smoke frame 2"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/frames/{frameId}/versions"
        }
      ]
    },
    {
      "group": "/api/github",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/github/app"
        }
      ],
      "noWrite": "connect and import need GitHub App credentials, which the sandbox must not hold"
    },
    {
      "group": "/api/home",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/home/activity"
        }
      ],
      "noWrite": "the activity feed is derived from the writes above"
    },
    {
      "group": "/api/image-descriptions",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/image-descriptions",
          "expectJson": {
            "mode": "account"
          }
        },
        {
          "kind": "write",
          "method": "PUT",
          "path": "/api/image-descriptions",
          "body": {
            "mode": "off"
          },
          "expectJson": {
            "mode": "off"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/image-descriptions",
          "expectJson": {
            "mode": "off"
          }
        }
      ]
    },
    {
      "group": "/api/image-model",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/image-model",
          "expectJson": {
            "models.0.id": "gpt-image-2"
          }
        }
      ],
      "noWrite": "no image model is available without provider keys, so a selection cannot succeed"
    },
    {
      "group": "/api/integrations",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/integrations"
        },
        {
          "kind": "write",
          "method": "DELETE",
          "path": "/api/integrations/meta"
        }
      ]
    },
    {
      "group": "/api/live-activities",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/live-activities/config",
          "expectJson": {
            "enabled": "false"
          }
        },
        {
          "kind": "contract",
          "method": "PUT",
          "path": "/api/live-activities/push-to-start",
          "expect": [503],
          "contract": "APNs is not configured in the sandbox, so 503 is the contract",
          "body": {
            "token": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "environment": "sandbox",
            "origin": "https://doop.example"
          }
        }
      ],
      "noWrite": "registering needs APNs"
    },
    {
      "group": "/api/local-agent",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/local-agent"
        },
        {
          "kind": "write",
          "method": "PUT",
          "path": "/api/local-agent",
          "body": {
            "enabled": false,
            "model": "sonnet"
          },
          "expectJson": {
            "enabled": "false",
            "model": "sonnet"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/local-agent",
          "expectJson": {
            "model": "sonnet"
          }
        }
      ]
    },
    {
      "group": "/api/version",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/version",
          "auth": false
        }
      ],
      "noWrite": "read-only build stamp; there is nothing to write"
    },
    {
      "group": "/api/locale-config",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/locale-config",
          "auth": false
        }
      ],
      "noWrite": "read-only server configuration; there is nothing to write"
    },
    {
      "group": "/api/mcp-consent",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/api/mcp-consent/none",
          "expect": [404],
          "contract": "an unknown consent code is refused"
        },
        {
          "kind": "contract",
          "method": "POST",
          "path": "/api/mcp-consent/none",
          "expect": [400],
          "contract": "an unknown consent code is refused",
          "body": {}
        }
      ],
      "noWrite": "a consent code only exists mid-OAuth with an MCP client"
    },
    {
      "group": "/api/me",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/me",
          "expectJson": {
            "email": "{email}"
          }
        }
      ],
      "noWrite": "the profile is written through /api/auth"
    },
    {
      "group": "/api/model-account",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/model-account",
          "expectJson": {
            "accounts.length": "0"
          }
        }
      ],
      "noWrite": "changing the model needs a connected provider account"
    },
    {
      "group": "/api/notifications",
      "calls": [
        {
          "kind": "write",
          "method": "PUT",
          "path": "/api/notifications",
          "body": {
            "commentEmails": false
          },
          "expectJson": {
            "commentEmails": "false"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/notifications",
          "expectJson": {
            "commentEmails": "false"
          }
        }
      ]
    },
    {
      "group": "/api/oidc-config",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/oidc-config",
          "auth": false
        }
      ],
      "noWrite": "read-only server configuration; there is nothing to write"
    },
    {
      "group": "/api/tasks",
      "calls": [
        {
          "kind": "contract",
          "method": "POST",
          "path": "/api/tasks/none/feedback",
          "expect": [404],
          "contract": "an unknown task id is refused with 404",
          "body": {}
        }
      ],
      "noWrite": "a task exists only while an agent runs; the sandbox has no agent"
    },
    {
      "group": "/api/webhooks",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/webhooks"
        }
      ],
      "noWrite": "webhook endpoints are created by a provider connection the sandbox does not have"
    },
    {
      "group": "/api/workspaces",
      "calls": [
        {
          "kind": "write",
          "method": "POST",
          "path": "/api/workspaces",
          "body": {
            "name": "Deploy smoke"
          },
          "save": {
            "workspaceId": "id"
          },
          "expectJson": {
            "name": "Deploy smoke"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/workspaces/{workspaceId}",
          "expectJson": {
            "name": "Deploy smoke",
            "role": "owner"
          }
        },
        {
          "kind": "read",
          "method": "GET",
          "path": "/api/workspaces"
        }
      ]
    },
    {
      "group": "/assets",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/assets/none.js",
          "expect": [404],
          "contract": "a missing file answers 404: the route and its store are up",
          "auth": false
        }
      ],
      "noWrite": "built assets are read-only; there is nothing to write"
    },
    {
      "group": "/bg",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/bg/none.png",
          "expect": [404],
          "contract": "a missing file answers 404: the route and its store are up",
          "auth": false
        }
      ],
      "noWrite": "background images are read-only; there is nothing to write"
    },
    {
      "group": "/gemini-cloud",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/gemini-cloud/mcp/none",
          "expect": [403],
          "contract": "the worker protocol needs a worker token; 403 is the contract",
          "auth": false
        }
      ],
      "noWrite": "worker protocol; needs a worker token"
    },
    {
      "group": "/healthz",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/healthz",
          "auth": false,
          "expectJson": {
            "ok": "true"
          }
        }
      ],
      "noWrite": "health is a read-only probe; there is nothing to write"
    },
    {
      "group": "/i",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/i/none.png",
          "expect": [404],
          "contract": "a missing file answers 404: the route and its store are up",
          "auth": false
        }
      ],
      "noWrite": "image routes are read-only; there is nothing to write"
    },
    {
      "group": "/icons",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/icons/iconify/x/not-svg",
          "expect": [404],
          "contract": "a name that is not an .svg answers 404 before any outside fetch",
          "auth": false
        }
      ],
      "noWrite": "icon routes are read-only copies of an outside set; there is nothing to write"
    },
    {
      "group": "/ingest",
      "calls": [
        {
          "kind": "contract",
          "method": "POST",
          "path": "/ingest/none",
          "expect": [200, 204, 400, 401, 403, 404],
          "contract": "analytics ingest answers by its key, never with 5xx: sandbox has no analytics host",
          "body": {},
          "auth": false
        }
      ],
      "noWrite": "fire-and-forget analytics intake; nothing is stored"
    },
    {
      "group": "/local-agent",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/local-agent/mcp/none",
          "expect": [403],
          "contract": "the local agent protocol needs a device token; 403 is the contract",
          "auth": false
        }
      ],
      "noWrite": "device protocol; needs a registered device"
    },
    {
      "group": "/mcp",
      "calls": [
        {
          "kind": "write",
          "method": "POST",
          "path": "/mcp",
          "body": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/list",
            "params": {}
          },
          "auth": false,
          "headers": {
            "authorization": "Bearer {agentKey}",
            "accept": "application/json, text/event-stream"
          }
        },
        {
          "kind": "contract",
          "method": "POST",
          "path": "/mcp",
          "expect": [401],
          "contract": "a request with no agent key must be refused",
          "body": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/list",
            "params": {}
          },
          "auth": false,
          "headers": {
            "accept": "application/json, text/event-stream"
          }
        }
      ]
    },
    {
      "group": "/photos",
      "calls": [
        {
          "kind": "contract",
          "method": "GET",
          "path": "/photos/pexels/not-a-photo",
          "expect": [404],
          "contract": "a file name that is no Pexels photo answers 404 before any outside fetch",
          "auth": false
        }
      ],
      "noWrite": "photo routes are read-only copies of an outside set; there is nothing to write"
    },
    {
      "group": "/relay",
      "calls": [
        {
          "kind": "contract",
          "method": "POST",
          "path": "/relay/e",
          "expect": [200, 204, 400, 401, 403, 404, 502, 503, 504],
          "contract": "the relay proxies to the analytics host; with no egress any proxy answer is accepted, a crash is not",
          "body": {},
          "auth": false
        }
      ],
      "noWrite": "a proxy to an external host; the sandbox has no egress"
    },
    {
      "group": "/robots.txt",
      "calls": [
        {
          "kind": "read",
          "method": "GET",
          "path": "/robots.txt",
          "auth": false
        }
      ],
      "noWrite": "a static file served as is; there is nothing to write"
    },
    {
